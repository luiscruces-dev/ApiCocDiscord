# Copia este archivo a ".env" (sin el ".example") y completa los valores.
# El archivo ".env" NUNCA debe subirse a git.

# Puerto donde escucha el puente HTTP.
PORT=3001

# Token secreto que el bot de Discord manda en cada request para poder usar
# este puente. Invéntate algo largo y random, ej. con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=

# JID del grupo de WhatsApp al que se reenvían los mensajes (termina en @g.us).
# No lo vas a saber la primera vez, andá así:
#   1. Dejá esto vacío y arrancá el puente (npm start).
#   2. Escaneá el QR que aparece en la terminal con WhatsApp -> Dispositivos
#      vinculados -> Vincular un dispositivo.
#   3. Con el puente ya conectado, pedí GET http://localhost:3001/grupos con
#      el header "Authorization: Bearer TU_BRIDGE_TOKEN" (ej. con curl o Postman).
#   4. Ahí sale la lista de tus grupos con su ID. Copiá el que quieras acá y
#      reiniciá el puente.
WHATSAPP_GROUP_ID=

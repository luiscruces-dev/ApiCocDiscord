# Copia este archivo a ".env" (sin el ".example") y completa tus valores.
# El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).

# Token del bot, sacado de https://discord.com/developers/applications -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# Token de la API de Clash of Clans, sacado de https://developer.clashofclans.com
# IMPORTANTE: al crear la key, en "Allowed IP Address" pon 45.79.218.79 (la IP del
# proxy de RoyaleAPI), NO la IP de tu casa. Así no se rompe si tu IP cambia.
COC_API_TOKEN=

# Tag de tu clan, con el # incluido, ej: #2ABC123XY
CLAN_TAG=

# Opcional pero recomendado mientras desarrollas: el ID de tu servidor de Discord.
# Con esto los slash commands se sincronizan al instante solo ahí (en vez de
# tardar hasta 1h en aparecer globalmente). Actívalo con: Ajustes de usuario ->
# Avanzado -> Modo desarrollador, luego clic derecho sobre el server -> Copiar ID.
GUILD_ID=

# Opcional: solo si en algún momento NO quieres pasar por el proxy de RoyaleAPI
# (por ejemplo porque ya tienes IP fija). Si no lo tocas, usa el proxy por defecto.
# COC_BASE_URL=https://api.clashofclans.com/v1
